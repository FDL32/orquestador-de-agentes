{
  "schema_version": "1.4",
  "_migrations": [
    "1.0_to_1.1",
    "1.1_to_1.2",
    "1.2_to_1.3",
    "1.3_to_1.4"
  ],
  "active_profile": "engine-dev",
  "strictness_profile": "standard",
  "profiles": {
    "minimal": {
      "description": "Solo la superficie sensible minima",
      "write_roots": [],
      "blocked_command_patterns": []
    },
    "standard": {
      "description": "Replica la proteccion actual como default; bloquea ejecucion piped desde red",
      "write_roots": [],
      "blocked_command_patterns": [
        "curl\\s+.*\\|.*sh",
        "wget\\s+.*\\|.*sh"
      ]
    },
    "strict": {
      "description": "Endurece el guard sin bloquear superficies canonicas vivas",
      "write_roots": [],
      "blocked_command_patterns": [
        "chmod\\s+777",
        "curl\\s+.*\\|.*sh",
        "wget\\s+.*\\|.*sh",
        "eval\\s+.*base64",
        "python.*-c.*exec"
      ]
    }
  },
  "backends": {
    "kilo": {
      "executable": "kilo.exe",
      "args": [
        "run",
        "--auto"
      ],
      "discovery": {
        "method": "vscode_extension",
        "extension_glob": "kilocode.kilo-code-*",
        "binary_name": "kilo.exe",
        "path_fallback": true
      }
    },
    "codex": {
      "executable": "codex.cmd",
      "args": [
        "exec",
        "--skip-git-repo-check",
        "-c",
        "service_tier=\"fast\""
      ],
      "prompt_via_stdin": true,
      "discovery": {
        "method": "path_only",
        "extension_glob": "openai.chatgpt-*",
        "binary_name": "codex.exe",
        "path_fallback": true
      }
    },
    "opencode": {
      "executable": "opencode",
      "args": [
        "run"
      ],
      "discovery": {
        "method": "path_only"
      }
    },
    "claude": {
      "executable": "claude",
      "args": [
        "-p"
      ],
      "prompt_via_stdin": true,
      "discovery": {
        "method": "path_only"
      },
      "trusted": true
    },
    "nan_api": {
      "executable": "",
      "args": [],
      "discovery": {
        "method": "path_only"
      }
    },
    "default": {
      "executable": "",
      "args": [],
      "discovery": {
        "method": "path_only"
      }
    }
  },
