    "1.2_to_1.3",
    "1.3_to_1.4"
  ],
  "active_profile": "engine-dev",
  "strictness_profile": "standard",
  "profiles": {
    "minimal": {
      "description": "Solo la superficie sensible minima",
      "write_roots": [],
      "blocked_command_patterns": []
    },
    "standard": {
      "description": "Replica la proteccion actual como default; bloquea ejecucion piped desde red",
      "write_roots": [],
      "blocked_command_patterns": [
        "curl\\s+.*\\|.*sh",
        "wget\\s+.*\\|.*sh"
      ]
    },
    "strict": {
      "description": "Endurece el guard sin bloquear superficies canonicas vivas",
      "write_roots": [],
      "blocked_command_patterns": [
        "chmod\\s+777",
        "curl\\s+.*\\|.*sh",
        "wget\\s+.*\\|.*sh",
        "eval\\s+.*base64",
        "python.*-c.*exec"
      ]
    }
  },
  "backends": {
    "kilo": {
      "executable": "kilo.exe",
      "args": [
        "run",
        "--auto"
      ],
      "discovery": {
        "method": "vscode_extension",
        "extension_glob": "kilocode.kilo-code-*",
        "binary_name": "kilo.exe",
        "path_fallback": true
      }
    },
    "codex": {
      "executable": "codex.cmd",
      "args": [
        "exec",
        "--skip-git-repo-check",
        "--sandbox",
        "read-only",
        "-c",
        "model_reasoning_effort=\"low\""
      ],
      "prompt_via_stdin": true,
      "discovery": {
        "method": "path_only",
        "extension_glob": "openai.chatgpt-*",
        "binary_name": "codex.exe",
        "path_fallback": true
      },
      "model_flag": [
        "-m",
        "{model}"
      ]
    },
    "opencode": {
      "executable": "opencode",
      "timeout_s": 900,
      "args": [
        "run"
      ],
      "prompt_via_stdin": true,
      "model_flag": [
        "--model",
        "{model}"
      ],
      "readonly_agent": "auditor",
      "discovery": {
        "method": "path_only"
      }
    },
    "claude": {
      "executable": "claude",
      "args": [
        "-p",
        "--tools",
        "Read,Grep,Glob"
      ],
      "prompt_via_stdin": true,
      "discovery": {
        "method": "path_only"
      },
      "trusted": true
    },
