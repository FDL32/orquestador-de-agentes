# Overrides locales del sistema multi-agente
.claude/settings.local.json
.agent/config/hooks_config.local.json

# Caches y artefactos temporales
.pytest_cache/
.ruff_cache/
.tmp/
tmp_pytest_*/
__pycache__/
.kilocode/
**/__pycache__/
.runtime/test_runtime/
.runtime/probe_dirs/
.runtime/pytest_safe/
.agent/runtime/tmp/
.agent/runtime/uv-cache/
graphify-out/
debug_output.txt
output.txt
temp_output.txt

# Runtime/logs generados
.agent/runtime/pytest-safe/
.agent/logs/*.log
.agent/test_logs/
tests/.test_workspace/

# Exclusion explicita del mirror oculto de tests
.__pytest_hidden__/

# Pre-commit cache
.cache/

# Runtime state per-process (no commitear)
.agent/runtime/*.txt
.agent/runtime/*.json
.agent/runtime/audit/
.agent/runtime/compare/
.agent/runtime/reviews/
.agent/runtime/review_packets/
.agent/runtime/events/logs/
.agent/collaboration/.session_state.json
.agent/context/
.agent/audits/
orchestrator_pipeline/

# Cache de modulos de PowerShell creada accidentalmente en el arbol
/Microsoft/

# Output runtime del refactor-kit (resultados de fase, regenerable)
/.refactor/
# Snapshots rotados de notifications.md (superficie viva, regenerable)
.agent/collaboration/archive/

# Codex CLI runtime (sessions contienen prompts y rollouts sensibles, no commitear)
.codex/

# Logs de debug capturados ad hoc
*.log

# Pytest sandbox runtime (archivos generados, algunos corruptos a proposito para
# testear error handling - no deben llegar a check-json/check-toml en CI)
tests/sandbox/test_runtime/
tests/sandbox/_check_mem/
tests/sandbox/_check_mem2/
tests/sandbox/debug_request/
tests/sandbox/probe_dirs/
tests/sandbox/tmp*/
.agent/runtime/memory/observations.jsonl.bak.*
.agent/runtime/memory/CONSOLIDATION_REPORT.md
.agent/runtime/research/
.agent/backups/
.agent/config/motor_destination_link.json
# WOT-2026-020s: prefix-resolver local overrides (destinations outside search tree)
scripts/prefix_resolver.local.json

# Requeue claims atomico (WT-2026-199, transitorio)
.agent/runtime/requeue_claims/

# Prompts del motor son producto y se versionan. Solo se excluyen debug temporales.
prompts/debug_*.md
# Runtime/historia de tickets del motor: vivir en workspace destino, no en producto
.agent/collaboration/manager_feedback_*.md
.agent/collaboration/AUDIT_WP-*.md
.agent/collaboration/PLAN_WP-*.md
# Per-ticket archived artifacts del motor (WOT-*): viven en workspace destino,
# no en producto. Patron broad *_WOT-*.md cubre AUDIT/PLAN/execution_log/
# work_plan/STRATEGY WOT-* (WOT-2026-020d). Las live surfaces sin sufijo _WOT
# (STATE/TURN/execution_log/work_plan/notifications/review_queue) quedan trackeadas.
.agent/collaboration/*_WOT-*.md
.agent/collaboration/_archive/
.agent/runtime/events/archive/
.agent/runtime/deliverables/
.agent/runtime/approvals/
.agent/runtime/memory/session_close_report.md

# Checkpoints
checkpoint/

# Runtime state generado en sesion (WOT-2026-015c) - NO distribuir con el motor
.agent/runtime/events/events.jsonl
.agent/runtime/memory/observations.jsonl
.agent/runtime/memory/MEMORY.md
.agent/runtime/memory/memory_profile.md
.agent/runtime/memory/memory_rules.md
.agent/runtime/memory/UPSTREAM_LEARNINGS.md
.agent/runtime/memory/closeout_lessons.md

# Artefactos locales de QA (WOT-2026-015e, MANIFEST.distribute EXPLICITAMENTE EXCLUIDO)
/MI_PROYECTO.bat
/validate_template.bat
/VERIFY_VERSION.sh
